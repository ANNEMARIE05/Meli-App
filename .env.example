# ==============================================================================
# MELI-APP — Variables d'environnement (EXEMPLE)
# ==============================================================================
# Copier ce fichier en .env et remplir les valeurs réelles.
# Ce fichier PEUT être commité dans git (il ne contient pas de secrets).
# ==============================================================================


# --- API ---
EXPO_PUBLIC_API_URL=https://api.meli.app
EXPO_PUBLIC_API_TIMEOUT=10000


# --- MAPS ---
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=


# --- AUTHENTIFICATION ---
EXPO_PUBLIC_SESSION_TIMEOUT=3600


# --- APP ---
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_DEBUG=true
